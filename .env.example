# Copy this file to .env for local development and fill in your own values.
# Never commit .env. In production, set these as environment variables on the
# hosting platform instead of uploading a .env file.

# Long random string used to sign Flask sessions and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Cloudflare Turnstile keys (from the Cloudflare dashboard, Turnstile section).
# The site key is public. The secret key must stay on the server only.
TURNSTILE_SITE_KEY=replace-with-your-site-key
TURNSTILE_SECRET_KEY=replace-with-your-secret-key

# Optional but recommended in production: comma-separated hostnames that the
# Turnstile widget may run on, e.g. your-domain.example,www.your-domain.example
# Leave empty for local development.
TURNSTILE_EXPECTED_HOSTNAMES=

# Number of reverse proxies in front of the app. 0 = no proxy (local development).
TRUSTED_PROXY_COUNT=0

# Rate limit storage. memory:// is fine for local development.
# With several workers, use a shared store such as redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Limits for POST /contact, separated by semicolons.
CONTACT_RATE_LIMIT=5 per 10 minutes; 20 per day

# Set to 1 only for local development (enables the Flask debugger). Keep 0 in production.
FLASK_DEBUG=0
